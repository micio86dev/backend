APP_NAME=BEAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — connect to the docker-compose beai service
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=beai
DB_USERNAME=beai
DB_PASSWORD=beai

# PostgreSQL test database (used by Pest via .env.testing)
# DB_DATABASE=beai_test

# Redis — connect to the docker-compose redis service
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — LOCAL goes to the docker-compose mailpit service.
# PRODUCTION uses Resend (C12, ratified 2026-07-30): set MAIL_MAILER=resend and
# RESEND_API_KEY in the deployment environment, never here. MAIL_FROM_ADDRESS
# must then be on a domain VERIFIED in the Resend dashboard — an unverified
# sender does not fail at boot, it throws inside the queued notification job and
# surfaces as a `failed` row in notification_logs.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@beai.test"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# JWT — configure in C2 (auth is not wired in C1)
JWT_SECRET=
JWT_ALGO=HS256

# Anthropic API — required for production scoring (C9 D7 resolved)
# Set in .env (local), Railway env vars (production), and ai-integration CI secrets
# Never commit the real key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT=60
SCORING_MODEL_VERSION=claude-haiku-4-5-20251001
SCORING_PROMPT_VERSION=1.0.0

# Resend — production mail transport (C12). Name documented here, value NEVER.
# Set it in Railway's variable store alongside MAIL_MAILER=resend.
RESEND_API_KEY=

# Laravel Pulse — platform operators (C13). Comma-separated emails.
# EMPTY BY DEFAULT and that is deliberate: `admin` in BEAI is org-scoped, but
# Pulse is cross-tenant, so the admin role alone would show every customer's
# data to every customer's admin. Both the role AND this list are required.
# See docs/observability.md.
PULSE_OPERATORS=

# Sentry — deployment credential. Name documented here, value NEVER.
SENTRY_LARAVEL_DSN=

# ── Interview avatar providers (C7/C14) ─────────────────────────────────
# Only the API keys are read by the running app. LiveAvatar is HeyGen's
# product name for the same service, so LIVEAVATAR_* is accepted as an
# alias of HEYGEN_* by beai:demo-seed.
INTERVIEW_PROVIDER=heygen
HEYGEN_API_KEY=
TAVUS_API_KEY=

# beai:demo-seed only: avatar/voice/persona/replica ids. At runtime these
# live in avatar_templates.config and are edited from the backoffice, not
# here. Falls back to committed working values when unset — see
# App\Support\Demo\DemoDataset::avatarIdentity().
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_LANGUAGE=it

# ── Entry link origin (operator-interview-link) ─────────────────────────
# The CANDIDATE app's origin (frontend/), NOT the backoffice. Composes the
# operator-facing entry_url; fails loud at mint time when unset — never
# falls back to APP_URL, which is this API's own origin.
CANDIDATE_APP_URL=http://localhost:3000
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=

# ── Object storage: candidate webcam frames (C7a/C13, object-storage-fix) ──
# FILESYSTEM_DISK is the ONLY thing that decides where snapshots live.
# Application code never names a disk. local = development (storage/app/private,
# no cloud credentials needed); s3 = production (Cloudflare R2). local is NOT
# an acceptable production value.
FILESYSTEM_DISK=local

# Cloudflare R2 — production only. Names documented here, values NEVER.
# EU jurisdiction bucket: the endpoint host carries a `.eu.` segment,
# e.g. https://<account-id>.eu.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=beai-snapshots
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# MUST stay empty. Laravel's S3 adapter rewrites the base URL of a generated
# temporaryUrl() when this is set. Pointed at a public r2.dev domain the
# signature becomes decorative and identifiable webcam frames are world-
# readable; pointed anywhere else the signature simply fails. Either way the
# 15-minute presigned URL that protects the snapshots (D4) is gone.
AWS_URL=
