APP_NAME=BEAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — connect to the docker-compose beai service
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=beai
DB_USERNAME=beai
DB_PASSWORD=beai

# PostgreSQL test database (used by Pest via .env.testing)
# DB_DATABASE=beai_test

# Redis — connect to the docker-compose redis service
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — LOCAL goes to the docker-compose mailpit service.
# PRODUCTION uses Resend (C12, ratified 2026-07-30): set MAIL_MAILER=resend and
# RESEND_API_KEY in the deployment environment, never here. MAIL_FROM_ADDRESS
# must then be on a domain VERIFIED in the Resend dashboard — an unverified
# sender does not fail at boot, it throws inside the queued notification job and
# surfaces as a `failed` row in notification_logs.
#
# LOCAL DEV AND CI NEED NO RESEND KEY. MAIL_MAILER below stays `smtp`
# (Mailpit) locally and phpunit.xml pins it to `array`; neither transport ever
# reads RESEND_API_KEY, so an empty key is a working default rather than a
# missing prerequisite. Only setting MAIL_MAILER=resend makes the key required.
#
# Self-service password reset (self-service-password-reset) sends through this
# same transport. In production its sender is noreply@quint.org, which means
# quint.org must be VERIFIED in Resend before the feature is enabled.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@beai.test"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# JWT — configure in C2 (auth is not wired in C1)
JWT_SECRET=
JWT_ALGO=HS256

# CORS allowlist (backoffice-session-refresh-hardening D1). Comma-separated,
# NO wildcard, NO regex pattern. MUST include BOTH Nuxt origins — the
# candidate `frontend` also calls api/*, so a backoffice-only allowlist takes
# the candidate app down. See docs/deploy.md.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# The backoffice SPA's own origin. ONE variable, TWO consumers, and they must
# never disagree — introducing a second name for this URL (BACKOFFICE_URL,
# PASSWORD_RESET_URL) would ship a deployment with a working CSP and broken
# emails, or the reverse:
#   1. SecurityHeaders builds the Content-Security-Policy from it. Unset or
#      invalid → a safe block-all CSP.
#   2. The password-reset link is built from it. Unset or invalid → the mail is
#      NOT sent and the refusal is logged. A reset mail whose link goes nowhere
#      is worse than no mail: the user believes recovery is under way and stops
#      looking for another route.
# Must be an explicit, non-wildcard http(s) origin with no trailing path.
BACKOFFICE_ORIGIN=http://localhost:3001

# Password-reset token lifetime, in MINUTES (config/auth.php
# passwords.users.expire). 60 keeps Laravel's default rather than inventing a
# fourth TTL in this codebase. Also governs the "expires in N minutes" line in
# the reset email, which reads the same value — never a second constant.
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=60

# Refresh-token family (backoffice-session-refresh-hardening D2/D6/D7).
# ABSOLUTE ceiling from login, never sliding — see config/refresh_tokens.php.
REFRESH_TOKEN_ABSOLUTE_TTL_MINUTES=20160
# D6: two tabs presenting the same cookie within this window are treated as
# a concurrent duplicate, not a replay. Tune with care — see D6/A7.
REFRESH_CONCURRENCY_GRACE_SECONDS=10

# Anthropic API — required for production scoring (C9 D7 resolved)
# Set in .env (local), Railway env vars (production), and ai-integration CI secrets
# Never commit the real key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT=60
SCORING_MODEL_VERSION=claude-haiku-4-5-20251001
# Bumped 1.0.0 -> 2.0.0 (bars-full-scale-1-5 D8): the AD-1 ordered relational
# rubric replaces the old "Do NOT use scores 2, 4" prompt. This is the
# LOCAL/CI default only. Any deploy environment (Railway production api
# service) that sets SCORING_PROMPT_VERSION explicitly, overriding this
# default, MUST be bumped separately at deploy time — this file's value never
# reaches an environment where the variable is pinned. See D8 parity test in
# tests/Unit/Services/PromptBuilderTest.php.
SCORING_PROMPT_VERSION=3.0.0

# ── Conversation engine (C8) ──────────────────────────────────────────────────
# The avatar's INTERVIEW prompt. Deliberately versioned separately from
# SCORING_PROMPT_VERSION above: the two prompts have independent lifecycles, and
# conflating them would make an interview change look like a scoring change in
# an evaluation's provenance.
# Bump on ANY edit to the conversation prompt template.
# Same deploy caveat as SCORING_PROMPT_VERSION: an environment that pins this
# explicitly must be bumped separately — this file's value never reaches it.
CONVERSATION_PROMPT_VERSION=conv-2026-09-04

# Max follow-up questions per competency, EXCLUDING the opening question.
# Ratified at 4 on 2026-08-25, closing the C8 open question that had kept it at
# a provisional 2.
CONVERSATION_FOLLOWUP_BUDGET=4

# Minimum questions (opening included) before the avatar may close a competency.
# SystemPromptComposer clamps this to `min(value, budget + 1)` — a minimum the
# budget cannot satisfy is an instruction the avatar can never obey, and the
# competency then runs to its session cap.
CONVERSATION_MIN_QUESTIONS=4

# Resend — production mail transport (C12). Name documented here, value NEVER.
# Set it in Railway's variable store alongside MAIL_MAILER=resend.
RESEND_API_KEY=

# Laravel Pulse — platform operators (C13). Comma-separated emails.
# EMPTY BY DEFAULT and that is deliberate: `admin` in BEAI is org-scoped, but
# Pulse is cross-tenant, so the admin role alone would show every customer's
# data to every customer's admin. Both the role AND this list are required.
# See docs/observability.md.
PULSE_OPERATORS=

# Sentry — deployment credential. Name documented here, value NEVER.
SENTRY_LARAVEL_DSN=

# ── Interview avatar providers (C7/C14) ─────────────────────────────────
# Only the API keys are read by the running app. LiveAvatar is HeyGen's
# product name for the same service, so LIVEAVATAR_* is accepted as an
# alias of HEYGEN_* by beai:demo-seed.
INTERVIEW_PROVIDER=heygen
HEYGEN_API_KEY=
TAVUS_API_KEY=

# Avatar/voice/persona/replica ids — read for TWO purposes:
#   1. beai:demo-seed: seeds one organization's avatar_templates.config row
#      (see App\Support\Demo\DemoDataset::avatarIdentity()).
#   2. HegenProvider's PLATFORM-DEFAULT avatar identity (config
#      interview.heygen.{avatar_id,voice_id,language}): the fallback HeyGen
#      session-token body used when an org has NO active AvatarTemplate — the
#      state every org is in today. Without these set, every /start 422s
#      with "avatar_id: Field required" (hotfix 0.22.1).
# At runtime, an org's OWN template (edited from the backoffice) still wins
# over this fallback when it sets a value.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_LANGUAGE=it

# ── Entry link origin (operator-interview-link) ─────────────────────────
# The CANDIDATE app's origin (frontend/), NOT the backoffice. Composes the
# operator-facing entry_url; fails loud at mint time when unset — never
# falls back to APP_URL, which is this API's own origin.
CANDIDATE_APP_URL=http://localhost:3000
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=

# NOTE: there is deliberately NO platform-wide Gemini API key here. The
# conversation LLM is bring-your-own-key PER ORGANIZATION: the key is stored
# in `llm_credentials.api_key`, encrypted at rest by the model cast, and is
# created through POST /api/llm-credentials — never from the environment.
# Nothing in the codebase reads a GEMINI_API_KEY env var.

# GeminiKeyValidator: per-attempt timeout and transport-failure retry count.
# 15s/1 retry are measured against the live endpoint — see
# config/conversation_llm.php and GeminiKeyValidator's docblock before changing.
CONVERSATION_LLM_VALIDATION_TIMEOUT=15
CONVERSATION_LLM_VALIDATION_RETRIES=1

# ── Object storage: candidate webcam frames (C7a/C13, object-storage-fix) ──
# FILESYSTEM_DISK is the ONLY thing that decides where snapshots live.
# Application code never names a disk. local = development (storage/app/private,
# no cloud credentials needed); s3 = production (Cloudflare R2). local is NOT
# an acceptable production value.
FILESYSTEM_DISK=local

# Cloudflare R2 — production only. Names documented here, values NEVER.
# EU jurisdiction bucket: the endpoint host carries a `.eu.` segment,
# e.g. https://<account-id>.eu.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=beai-snapshots
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# MUST stay empty. Laravel's S3 adapter rewrites the base URL of a generated
# temporaryUrl() when this is set. Pointed at a public r2.dev domain the
# signature becomes decorative and identifiable webcam frames are world-
# readable; pointed anywhere else the signature simply fails. Either way the
# 15-minute presigned URL that protects the snapshots (D4) is gone.
AWS_URL=

# ─── Platform superadmin (PlatformSuperadminSeeder) ──────────────────────────
# Opt-in: with SUPERADMIN_EMAIL unset the seeder does nothing.
#
# The password is READ FROM HERE AND NEVER COMMITTED. A literal in a seeder
# would put platform-wide production access — every tenant — into every clone,
# CI log and fork of this repository, and git history does not forget. With
# SUPERADMIN_PASSWORD unset the seeder REFUSES to create the account rather
# than inventing a default, because a default is the first credential anyone
# would try.
#
# Run it explicitly; it is deliberately NOT wired into DatabaseSeeder, which
# also runs in demo contexts:
#   php artisan db:seed --class=PlatformSuperadminSeeder --force
#
# Re-running is safe: an existing account keeps its password (so a rotation
# survives the next deploy) and has only its superadmin flags repaired.
SUPERADMIN_EMAIL=
SUPERADMIN_NAME="Platform Superadmin"
SUPERADMIN_PASSWORD=
