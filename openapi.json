{
    "openapi": "3.1.0",
    "info": {
        "title": "Laravel",
        "version": "0.1.0"
    },
    "servers": [
        {
            "url": "http://localhost/api"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "operationId": "auth.login",
                "description": "POST /api/auth/login\nPublic \u2014 no auth middleware.\n\nToken model (D4 \u2014 jwt-auth rotation):\n- Access token: standard TTL (30 min), used for all API requests.\n- Refresh token: re-issues a new access token via POST /api/auth/refresh.\n  jwt-auth rotation: the SAME bearer token is posted to /refresh; the old\n  token's jti is denylisted and a new token is returned. There is no separate\n  long-lived opaque refresh token \u2014 the \"refresh_token\" field carries the\n  same access token string returned at login.",
                "summary": "Attempt login and return a token pair",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "refresh_token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "const": "bearer"
                                        }
                                    },
                                    "required": [
                                        "access_token",
                                        "refresh_token",
                                        "token_type"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Invalid credentials."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "operationId": "auth.refresh",
                "description": "POST /api/auth/refresh\nProtected: auth:api\n\nUses jwt-auth's native token ROTATION: the current bearer access token is\npresented and a new access token is returned; the old token's jti is denylisted.",
                "summary": "Refresh the access token",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "const": "bearer"
                                        }
                                    },
                                    "required": [
                                        "access_token",
                                        "token_type"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "auth.logout",
                "description": "POST /api/auth/logout\nProtected: auth:api",
                "summary": "Logout \u2014 denylist the current token's jti + invalidate Spatie permission cache",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Successfully logged out."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "operationId": "auth.me",
                "description": "GET /api/auth/me\nProtected: auth:api",
                "summary": "Return the authenticated user, their organization, and their roles",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "email"
                                            ]
                                        },
                                        "organization": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "name": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name"
                                            ]
                                        },
                                        "roles": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "organization",
                                        "roles"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/framework/roles": {
            "get": {
                "operationId": "framework.index",
                "description": "Returns all global roles for ANY authenticated org.\nNo FrameworkVersion required \u2014 if absent, pin_context is null.",
                "summary": "GET /api/framework/roles",
                "tags": [
                    "Framework"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `RoleResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/RoleResource"
                                            }
                                        },
                                        "pin_context": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "version": {
                                                    "type": "string"
                                                },
                                                "label": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "is_locked": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "version",
                                                "label",
                                                "is_locked"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "pin_context"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/framework/roles/{roleCode}/competencies": {
            "get": {
                "operationId": "framework.roleCompetencies",
                "description": "Returns competencies for a specific role + bars_available flag (N+1-free).",
                "summary": "GET /api/framework/roles/{roleCode}/competencies",
                "tags": [
                    "Framework"
                ],
                "parameters": [
                    {
                        "name": "roleCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of `CompetencyResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CompetencyResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/framework/roles/{roleCode}/competencies/{competencyCode}/indicators": {
            "get": {
                "operationId": "framework.competencyBars",
                "description": "Returns BARS indicators + anchors for a role\u00d7competency pair.",
                "summary": "GET /api/framework/roles/{roleCode}/competencies/{competencyCode}/indicators",
                "tags": [
                    "Framework"
                ],
                "parameters": [
                    {
                        "name": "roleCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "competencyCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of `BarsIndicatorResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/BarsIndicatorResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "operationId": "health",
                "description": "This endpoint is NOT localized \u2014 it returns the literal string \"ok\" in every locale.\nMachine-readable status payloads are exempt from the i18n mandate (D31).",
                "summary": "Return a machine-readable health status",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "BarsIndicatorResource": {
                "type": "object",
                "properties": {
                    "position": {
                        "type": "integer"
                    },
                    "text": {
                        "type": "array",
                        "items": {}
                    },
                    "anchor_5": {
                        "type": "array",
                        "items": {}
                    },
                    "anchor_3": {
                        "type": "array",
                        "items": {}
                    },
                    "anchor_1": {
                        "type": "array",
                        "items": {}
                    },
                    "translation_gap": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "position",
                    "text",
                    "anchor_5",
                    "anchor_3",
                    "anchor_1",
                    "translation_gap"
                ],
                "title": "BarsIndicatorResource"
            },
            "CompetencyResource": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "array",
                        "items": {}
                    },
                    "definition": {
                        "type": "array",
                        "items": {}
                    },
                    "type": {
                        "type": "string"
                    },
                    "bars_available": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "code",
                    "name",
                    "definition",
                    "type",
                    "bars_available"
                ],
                "title": "CompetencyResource"
            },
            "RoleResource": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "array",
                        "items": {}
                    },
                    "responsibilities": {
                        "type": "array",
                        "items": {}
                    },
                    "competency_count": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "required": [
                    "code",
                    "name",
                    "responsibilities",
                    "competency_count"
                ],
                "title": "RoleResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}