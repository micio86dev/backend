<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!-- Exclude ONLY the Laravel skeleton User model from coverage gate (D9).
                 C2-authored models (Organization, TenantModel, Models/Concerns/TenantScoped)
                 are security-critical and MUST be included in the coverage gate. -->
            <file>app/Models/User.php</file>
        </exclude>
    </source>
    <coverage>
        <report>
            <text outputFile="php://stdout"/>
        </report>
    </coverage>
    <php>
        <!-- The suite does not fit PHP's 128M default: the coverage collector
             holds the whole `app/` line map, and parallel mode gives every
             worker its own copy, so a full run died with "Allowed memory size
             of 134217728 bytes exhausted" long before any assertion failed.
             A cap, not a reservation: PHP still allocates only what it uses,
             and 2G keeps a parallel run inside an 8GB machine. Set here rather
             than in php.ini so artisan test, its parallel workers and a bare
             vendor/bin/pest all get it. Passing the limit on the command line
             does NOT reach the child process artisan test spawns. -->
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="/>
        <env name="JWT_SECRET" value="testing-secret-key-for-phpunit-only-not-for-production-use"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="beai_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="XDEBUG_MODE" value="off"/>
    </php>
</phpunit>
